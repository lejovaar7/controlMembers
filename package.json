{
	"name": "saas-template",
	"description": "Base template for SaaS apps: React + Vite + TypeScript + Hono on Cloudflare Workers",
	"private": true,
	"type": "module",
	"packageManager": "npm@11.12.1",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"typecheck": "tsc -b",
		"lint": "eslint .",
		"preview": "npm run build && vite preview",
		"check": "npm run typecheck && npm run lint && npm test && npm run build && wrangler deploy --dry-run",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply saas-template-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply saas-template-db --remote",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.2",
		"better-auth": "1.7.2",
		"drizzle-orm": "0.45.2",
		"hono": "4.13.5",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.54.0",
		"@cloudflare/vitest-plugin": "1.1.1",
		"@eslint/js": "9.39.5",
		"@types/node": "26.4.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitejs/plugin-react": "5.2.0",
		"drizzle-kit": "0.31.10",
		"eslint": "9.39.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-refresh": "0.4.26",
		"globals": "16.5.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.68.0",
		"vite": "7.3.6",
		"vitest": "4.1.11",
		"wrangler": "4.127.0"
	}
}
