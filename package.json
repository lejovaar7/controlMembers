{
	"name": "saas-template",
	"description": "Base template for SaaS apps: React + Vite + TypeScript + Hono on Cloudflare Workers",
	"private": true,
	"type": "module",
	"packageManager": "npm@11.12.1",
	"scripts": {
		"dev": "node scripts/environments.mjs local dev",
		"build": "node scripts/environments.mjs local build",
		"build:dev": "node scripts/environments.mjs dev build",
		"build:production": "node scripts/environments.mjs production build",
		"typecheck": "tsc -b",
		"lint": "eslint .",
		"preview": "node scripts/environments.mjs local preview",
		"check": "npm run typecheck && npm run lint && npm test && npm run check:environments",
		"check:environments": "npm run deploy:dev:dry-run && npm run deploy:production:dry-run && node scripts/environments.mjs local dry-run",
		"deploy": "node scripts/environments.mjs",
		"deploy:dev": "node scripts/environments.mjs dev deploy",
		"deploy:production": "node scripts/environments.mjs production deploy",
		"deploy:dev:dry-run": "node scripts/environments.mjs dev dry-run",
		"deploy:production:dry-run": "node scripts/environments.mjs production dry-run",
		"cf-typegen": "node scripts/environments.mjs local types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "node scripts/environments.mjs local migrate",
		"db:migrate:dev": "node scripts/environments.mjs dev migrate",
		"db:migrate:production": "node scripts/environments.mjs production migrate",
		"db:migrate:remote": "node scripts/environments.mjs",
		"test": "npm run test:environments && node scripts/environments.mjs local test",
		"test:environments": "node --test scripts/environments.test.mjs",
		"test:watch": "node scripts/environments.mjs local test-watch"
	},
	"dependencies": {
		"@base-ui/react": "1.7.0",
		"@better-auth/drizzle-adapter": "1.7.2",
		"@fontsource-variable/geist": "5.3.0",
		"better-auth": "1.7.2",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"drizzle-orm": "0.45.2",
		"hono": "4.13.5",
		"lucide-react": "1.34.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-router": "8.3.0",
		"tailwind-merge": "3.6.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.54.0",
		"@cloudflare/vitest-plugin": "1.1.1",
		"@eslint/js": "9.39.5",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.4.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitejs/plugin-react": "5.2.0",
		"drizzle-kit": "0.31.10",
		"eslint": "9.39.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-refresh": "0.4.26",
		"globals": "16.5.0",
		"shadcn": "4.19.0",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.68.0",
		"vite": "7.3.6",
		"vitest": "4.1.11",
		"wrangler": "4.127.0"
	},
	"overrides": {
		"@esbuild-kit/core-utils@3.3.2": {
			"esbuild": "0.25.12"
		}
	}
}
