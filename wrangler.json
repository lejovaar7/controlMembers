{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "saas-template",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-08-27",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [],
	"secrets": {
		"required": ["BETTER_AUTH_SECRET", "APP_URL", "EMAIL_FROM"]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"send_email": [
		{
			"name": "EMAIL",
			"remote": false
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "saas-template-db",
			"database_id": "REPLACE_WITH_REAL_D1_DATABASE_ID",
			"migrations_dir": "./drizzle",
			"remote": false
		}
	],
	"env": {
		"dev": {
			"name": "saas-template-dev",
			"workers_dev": false,
			"preview_urls": false,
			"routes": [{ "pattern": "dev.example.invalid", "custom_domain": true }],
			"secrets": {
				"required": ["BETTER_AUTH_SECRET", "APP_URL", "EMAIL_FROM"]
			},
			"send_email": [{
				"name": "EMAIL",
				"allowed_destination_addresses": ["qa@example.invalid"],
				"remote": false
			}],
			"d1_databases": [{
				"binding": "DB",
				"database_name": "saas-template-dev-db",
				"database_id": "REPLACE_WITH_DEV_D1_DATABASE_ID",
				"migrations_dir": "./drizzle",
				"remote": false
			}]
		},
		"production": {
			"name": "saas-template-production",
			"workers_dev": false,
			"preview_urls": false,
			"routes": [{ "pattern": "app.example.invalid", "custom_domain": true }],
			"secrets": {
				"required": ["BETTER_AUTH_SECRET", "APP_URL", "EMAIL_FROM"]
			},
			"send_email": [{ "name": "EMAIL", "remote": false }],
			"d1_databases": [{
				"binding": "DB",
				"database_name": "saas-template-production-db",
				"database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
				"migrations_dir": "./drizzle",
				"remote": false
			}]
		}
	}
}
